{
  "name": "lockable-resources-remote-client-actions",
  "description": "GitHub Actions client for Jenkins Remote Lockable Resources (delegated mode)",
  "version": "0.1.0",
  "author": "kohtaro-satoh",
  "license": "MIT",
  "private": true,
  "type": "module",
  "homepage": "https://github.com/kohtaro-satoh/lockable-resources-remote-client-actions",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kohtaro-satoh/lockable-resources-remote-client-actions.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "all": "npm run format:write && npm run lint && npm run typecheck && npm test && npm run package && npm run test:integration",
    "format:write": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "package": "rollup --config rollup.config.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects integration"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "js-yaml": "^5.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "rollup": "^4.68.8",
    "ts-jest": "^29.4.15",
    "ts-jest-resolver": "^2.0.1",
    "tslib": "^2.9.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
