{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "rootDir": "./src",
    "noEmit": false,
    "outDir": "./dist",
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src"]
}
